<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#2f6b3f"><title>Impact Ledger</title>
<style>
:root{--bg:#f6f3ec;--card:#fffdf8;--ink:#1f2a22;--mute:#6b746c;--line:#e4dfd2;--acc:#2f6b3f;--acc2:#e9f1e6;--warn:#b4531a;--warn2:#fbeadc;--gold:#c58b1d;--bad:#a8332b;--shadow:0 1px 2px rgba(0,0,0,.06),0 6px 18px rgba(30,40,30,.06)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a15;--card:#1a241d;--ink:#eef2ea;--mute:#9aa79c;--line:#2b382e;--acc:#7cc58f;--acc2:#213427;--warn:#f0a26b;--warn2:#3a2a1d;--gold:#e5b44f;--bad:#f08a80;--shadow:none}}
:root[data-theme="dark"]{--bg:#121a15;--card:#1a241d;--ink:#eef2ea;--mute:#9aa79c;--line:#2b382e;--acc:#7cc58f;--acc2:#213427;--warn:#f0a26b;--warn2:#3a2a1d;--gold:#e5b44f;--bad:#f08a80;--shadow:none}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
#app{max-width:720px;margin:0 auto;padding:16px 16px 110px}
h1{font-size:22px;margin:0;letter-spacing:-.01em}
h2{font-size:13px;margin:22px 0 8px;text-transform:uppercase;letter-spacing:.08em;color:var(--mute);font-weight:600}
.top button.btn{min-width:44px;font-size:18px;padding:0}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:6px}
.sub{color:var(--mute);font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:12px 14px;margin:8px 0}
.row{display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--line);cursor:pointer}
.row:first-child{border-top:0}
.grow{flex:1;min-width:0}
.title{font-weight:550;overflow-wrap:anywhere}
.done .title{text-decoration:line-through;color:var(--mute)}
.meta{font-size:13px;color:var(--mute);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;margin-top:2px}
.chip{font-size:12px;padding:1px 8px;border-radius:99px;background:var(--acc2);color:var(--acc);white-space:nowrap}
.chip.w{background:var(--warn2);color:var(--warn)}
.chip.g{background:var(--line);color:var(--mute)}
.check{width:28px;height:28px;border-radius:9px;border:2px solid var(--line);background:var(--card);flex:none;display:grid;place-items:center;color:#fff;font-size:16px;padding:0;cursor:pointer}
.done .check{background:var(--acc);border-color:var(--acc)}
.dots{letter-spacing:1px;color:var(--gold);font-size:11px}
.bar{height:8px;border-radius:9px;background:var(--line);overflow:hidden}
.bar>i{display:block;height:100%;background:var(--acc);border-radius:9px}
.bar.w>i{background:var(--gold)}
.tabs{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);display:flex;justify-content:center;padding:6px 8px calc(8px + env(safe-area-inset-bottom));z-index:5}
.tabs div{display:flex;max-width:720px;width:100%;gap:4px}
.tabs button{flex:1;padding-left:0!important;padding-right:0!important;font-size:12.5px!important;border:0;background:none;color:var(--mute);font:inherit;font-size:13px;padding:8px 4px;border-radius:10px;cursor:pointer;min-height:44px}
.tabs button.on{background:var(--acc2);color:var(--acc);font-weight:650}
.fab{position:fixed;right:max(16px,calc(50% - 344px));bottom:calc(76px + env(safe-area-inset-bottom));background:var(--acc);color:#fff;border:0;border-radius:99px;padding:0 20px;height:48px;font:inherit;font-weight:650;box-shadow:0 6px 18px rgba(0,0,0,.25);cursor:pointer;z-index:6}
.dark-on-fab{color:var(--bg)}
button.btn{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;padding:0 14px;min-height:44px;cursor:pointer}
button.btn.p{background:var(--acc);border-color:var(--acc);color:#fff;font-weight:650}
button.btn.d{color:var(--bad)}
a.btn{display:inline-flex;align-items:center;text-decoration:none;font-size:14px;color:var(--acc);padding:0 4px;min-height:36px}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{flex:1;min-width:44px;font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;min-height:40px;cursor:pointer}
.seg button.on{background:var(--acc);border-color:var(--acc);color:#fff;font-weight:650}
.nav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:8px 0}
.nav b{text-align:center;flex:1}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tile{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px}
.tile small{color:var(--mute);display:block;font-size:12px}
.tile b{font-size:19px;font-variant-numeric:tabular-nums}
.tile.in b{color:var(--acc)}.tile.out b{color:var(--warn)}
.line{display:flex;justify-content:space-between;gap:10px;font-size:14px;padding:3px 0}
.line span:last-child{font-variant-numeric:tabular-nums}
textarea,input,select{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px;width:100%;min-height:44px}
textarea{min-height:84px;resize:vertical}
label{display:block;font-size:13px;color:var(--mute);margin:12px 0 4px}
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:20;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--card);width:100%;max-width:720px;max-height:92vh;overflow:auto;border-radius:18px 18px 0 0;padding:16px 16px calc(20px + env(safe-area-inset-bottom))}
.sheet h3{margin:0 0 4px;font-size:18px}
.acts{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
.acts .p{flex:1}
.empty{text-align:center;color:var(--mute);padding:22px 8px}
.note{font-size:13px;color:var(--mute);background:var(--acc2);border-radius:10px;padding:8px 10px;margin:8px 0}
.q{border-left:3px solid var(--gold);padding:2px 0 2px 10px;margin:8px 0;font-size:14px}
.q small{color:var(--mute);display:block}
</style></head><body>
<div id="app"></div>
<script>
(function(){
const $app=document.getElementById('app');
function el(t,p,...k){const e=document.createElement(t);for(const a in(p||{})){const v=p[a];if(v==null||v===false)continue;if(a==='class')e.className=v;else if(a.startsWith('on'))e[a]=v;else if(a==='text')e.textContent=v;else if(a==='value'||a==='checked'||a==='disabled')e[a]=v;else e.setAttribute(a,v===true?'':v)}
 for(const c of k.flat()){if(c==null||c===false)continue;e.append(c.nodeType?c:document.createTextNode(String(c)))}return e}
const pad=n=>String(n).padStart(2,'0');
const ymd=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const parse=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c,12)};
const addD=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const monday=d=>{const x=new Date(d);x.setDate(x.getDate()-((x.getDay()+6)%7));return x};
const todayS=()=>ymd(new Date());
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DAY=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const fmtD=s=>{const d=parse(s);return DAY[d.getDay()]+' '+d.getDate()+' '+MON[d.getMonth()]};
const naira=n=>(n<0?'-':'')+'₦'+Math.abs(Math.round(n)).toLocaleString('en-NG');
const keyFor=(h,d)=>h==='day'?ymd(d):h==='week'?ymd(monday(d)):h==='month'?ymd(d).slice(0,7):String(d.getFullYear());
const rangeOf=(h,d)=>{if(h==='day')return[ymd(d),ymd(d)];if(h==='week'){const m=monday(d);return[ymd(m),ymd(addD(m,6))]}
 if(h==='month')return[ymd(new Date(d.getFullYear(),d.getMonth(),1,12)),ymd(new Date(d.getFullYear(),d.getMonth()+1,0,12))];
 return[d.getFullYear()+'-01-01',d.getFullYear()+'-12-31']};
const HZ=[['day','Daily'],['week','Weekly'],['month','Monthly'],['year','Yearly']];
const HNAME={day:'Today',week:'This week',month:'This month',year:'This year'};
const AREAS=['Faith & personal','Business (Lausorgo)','Funding & applications','Farmers & field','Learning','Health','Family & community','Money'];
const GROUPS=[
 {g:'Giving',k:'give',o:[['tithe','Tithe'],['offering','Offering'],['donation','Donation / charity'],['support','Family support & gifts']]},
 {g:'Food & home',k:'home',o:[['feeding','Feeding / food'],['rent','Rent'],['utilities','Utilities (light, water)'],['household','Household items']]},
 {g:'Personal',k:'pers',o:[['clothing','Clothing & shoes'],['grooming','Toiletries & grooming'],['health','Health & medical'],['airtime','Airtime & data']]},
 {g:'Transport',k:'trans',o:[['transport','Transport / fare'],['fuel','Fuel']]},
 {g:'Work & growth',k:'work',o:[['bizexp','Business expense'],['learning','Training & education'],['tools','Books, tools & equipment']]},
 {g:'Obligations',k:'obl',o:[['loan','Loan repayment'],['fees','Fees, charges & taxes']]},
 {g:'Life',k:'life',o:[['fun','Recreation'],['events','Events & celebrations'],['other','Other / miscellaneous']]},
 {g:'Saving (set aside)',k:'save',o:[['savings','Savings'],['emergency','Emergency fund'],['invest','Investment']]},
 {g:'Income (money in)',k:'inc',o:[['salary','Salary / allowance'],['bizinc','Business income'],['grant','Grants & prizes'],['gift','Gifts received'],['otherinc','Other income']]}];
const CATG={},CATN={};GROUPS.forEach(G=>G.o.forEach(([v,l])=>{CATG[v]=G.k;CATN[v]=l}));
const GNAME={};GROUPS.forEach(G=>GNAME[G.k]=G.g);

let dl=null,db=null,uid=null,S={plans:[],notes:{},spend:[],pledges:[],apps:[],journal:[]},loaded=0,tab='today',R={h:'week',off:0},M={y:new Date().getFullYear(),m:new Date().getMonth(),yr:false},Pf='all',theme=null;
const col=n=>db.collection('data/users/'+uid+'/app/'+n);
const rid=()=>Math.random().toString(36).slice(2,10);

/* ---------- plan occurrences ---------- */
function isDone(p,key){return !!(p.done&&p.done[p.repeat?key:'once'])}
function visibleToday(p,now){
 const h=p.horizon,[,end]=rangeOf(h,now),key=keyFor(h,now),t=ymd(now);
 if(p.repeat)return{show:true,key};
 const dn=p.done&&p.done.once;
 if(dn)return{show:keyFor(h,parse(dn))===key,key:'once'};
 const due=p.due||(h==='day'?t:'');
 return{show:!due||due<=end,key:'once',overdue:!!due&&due<t&&h==='day'||(!!p.due&&p.due<t)};
}
function occIn(p,a,b){ // occurrences within [a,b] (strings), up to today
 const t=todayS(),out=[];
 if(!p.repeat){const ref=(p.done&&p.done.once)||p.due||(p.created||'').slice(0,10)||t;if(ref>=a&&ref<=b)out.push({done:!!(p.done&&p.done.once)});return out}
 const keys=new Set();for(let d=parse(a);ymd(d)<=b&&ymd(d)<=t;d=addD(d,1))keys.add(keyFor(p.horizon,d));
 keys.forEach(k=>out.push({done:!!(p.done&&p.done[k])}));return out}
function toggle(p,key){const k=p.repeat?key:'once',done={...(p.done||{})};if(done[k])delete done[k];else done[k]=p.repeat?true:todayS();
 const o={...p,done};delete o.id;return col('plans').doc(p.id).set(o)}

/* ---------- calendar link ---------- */
function calLink(p){
 const base=p.due||todayS(),d=base.replace(/-/g,'');let dates;
 if(p.time){const[h,m]=p.time.split(':').map(Number),e=new Date(2000,0,1,h,m+30);dates=d+'T'+pad(h)+pad(m)+'00/'+d+'T'+pad(e.getHours())+pad(e.getMinutes())+'00'}
 else dates=d+'/'+ymd(addD(parse(base),1)).replace(/-/g,'');
 const q=new URLSearchParams({action:'TEMPLATE',text:p.title||'Plan',details:(p.remark?p.remark+'\n\n':'')+'From my Impact Ledger',dates,ctz:'Africa/Lagos'});
 if(p.repeat)q.set('recur','RRULE:FREQ='+{day:'DAILY',week:'WEEKLY',month:'MONTHLY',year:'YEARLY'}[p.horizon]);
 return'https://calendar.google.com/calendar/render?'+q.toString()}

/* ---------- sheet ---------- */
function openSheet({title,fields,data,onSave,onDelete,extra}){
 const v={...data},inputs={};
 const body=el('div',{});
 fields.forEach(f=>{
  const lab=el('label',{text:f.label,for:'f_'+f.k});let inp;
  if(f.type==='seg'){inp=el('div',{class:'seg'});const draw=()=>{inp.replaceChildren(...f.opts.map(([val,l])=>el('button',{type:'button',class:String(v[f.k])===String(val)?'on':'',text:l,onclick:()=>{v[f.k]=val;draw();if(f.onchange)f.onchange()}})))};draw()}
  else if(f.type==='area'){inp=el('textarea',{id:'f_'+f.k,value:v[f.k]||'',placeholder:f.ph||'',oninput:e=>v[f.k]=e.target.value})}
  else if(f.type==='select'){inp=el('select',{id:'f_'+f.k,onchange:e=>v[f.k]=e.target.value});
   if(f.groups)f.groups.forEach(G=>inp.append(el('optgroup',{label:G.g},...G.o.map(([a,b])=>el('option',{value:a,text:b})))));
   else f.opts.forEach(([a,b])=>inp.append(el('option',{value:a,text:b})));inp.value=v[f.k]||''}
  else{inp=el('input',{id:'f_'+f.k,type:f.type==='number'?'text':f.type,value:v[f.k]==null?'':v[f.k],placeholder:f.ph||'',oninput:e=>v[f.k]=e.target.value});if(f.type==='number')inp.setAttribute('inputmode','decimal')}
  inputs[f.k]=inp;body.append(lab,inp)});
 let armed=false;const close=()=>{scrim.remove();render()};
 const err=el('div',{class:'note',style:'display:none;background:var(--warn2);color:var(--warn)'});
 const del=onDelete&&el('button',{class:'btn d',type:'button',text:'Delete',onclick:async()=>{if(!armed){armed=true;del.textContent='Tap again to delete';return}try{await onDelete();close()}catch(e){err.textContent='Could not delete.';err.style.display='block'}}});
 const sheet=el('div',{class:'sheet',role:'dialog'},el('h3',{text:title}),body,extra&&extra(v),err,
  el('div',{class:'acts'},el('button',{class:'btn p',type:'button',text:'Save',onclick:async()=>{
   try{const r=await onSave(v);if(r===false)return;close()}catch(e){err.textContent=(e&&e.message)||'Could not save. Your access may be view-only.';err.style.display='block'}}}),
   el('button',{class:'btn',type:'button',text:'Cancel',onclick:close}),del));
 const scrim=el('div',{class:'scrim',onclick:e=>{if(e.target===scrim)close()}},sheet);document.body.append(scrim);return v}

function planSheet(p){
 const isNew=!p;p=p||{horizon:'day',repeat:true,impact:3,area:AREAS[1],title:'',remark:'',due:'',time:''};
 openSheet({title:isNew?'New plan':'Edit plan',data:{...p,repeat:p.repeat?'r':'o'},
  fields:[{k:'title',label:'What do I want to do?',type:'text',ph:'e.g. Visit two farmers'},
   {k:'horizon',label:'Time frame',type:'seg',opts:HZ},
   {k:'repeat',label:'How often',type:'seg',opts:[['r','Repeats every period'],['o','Just once']]},
   {k:'area',label:'Area of life / work',type:'select',opts:AREAS.map(a=>[a,a])},
   {k:'impact',label:'Impact / importance (1 low – 5 high)',type:'seg',opts:[1,2,3,4,5].map(n=>[n,String(n)])},
   {k:'due',label:'Date (for one-off, or the first date for the calendar)',type:'date'},
   {k:'time',label:'Reminder time (optional, for Google Calendar)',type:'time'},
   {k:'remark',label:'Remark / notes',type:'area',ph:'Why it matters, what to remember, what happened…'}],
  extra:v=>el('div',{class:'note'},'Use the “Add to Google Calendar” link after saving to get phone reminders.'),
  onSave:async v=>{if(!(v.title||'').trim()){return false}
   const o={title:v.title.trim(),horizon:v.horizon,repeat:v.repeat==='r',area:v.area||AREAS[0],impact:+v.impact||3,due:v.due||'',time:v.time||'',remark:v.remark||'',done:p.done||{},created:p.created||todayS()};
   if(p.example)o.example=false;await col('plans').doc(p.id||rid()).set(o)},
  onDelete:p.id?()=>col('plans').doc(p.id).delete():null});}

function spendSheet(s){
 const isNew=!s;s=s||{date:todayS(),cat:'feeding',amount:'',note:''};
 openSheet({title:isNew?'Record money':'Edit entry',data:s,
  fields:[{k:'cat',label:'Category',type:'select',groups:GROUPS},
   {k:'amount',label:'Amount (₦)',type:'number',ph:'0'},
   {k:'date',label:'Date',type:'date'},
   {k:'note',label:'Remark',type:'text',ph:'e.g. Sunday offering, market food, shirt'}],
  extra:()=>null,
  onSave:async v=>{const a=parseFloat(String(v.amount).replace(/,/g,''));if(!(a>0))return false;
   await col('spend').doc(s.id||rid()).set({cat:v.cat||'feeding',amount:a,date:v.date||todayS(),note:v.note||''})},
  onDelete:s.id?()=>col('spend').doc(s.id).delete():null});}

function pledgeSheet(p){
 const isNew=!p;p=p||{dir:'give',who:'',amount:'',paid:'',due:'',note:''};
 openSheet({title:isNew?'New pledge':'Edit pledge',data:p,
  fields:[{k:'dir',label:'Type',type:'seg',opts:[['give','I pledged to give'],['receive','Promised to me']]},
   {k:'who',label:'To / from whom, and for what',type:'text',ph:'e.g. Church building fund, Samaila, a supporter'},
   {k:'amount',label:'Pledged amount (₦)',type:'number',ph:'0'},
   {k:'paid',label:'Paid / received so far (₦)',type:'number',ph:'0'},
   {k:'due',label:'Due date (optional)',type:'date'},
   {k:'note',label:'Remark',type:'area',ph:'Details, reminders, what was said'}],
  extra:()=>el('div',{class:'note',text:'A pledge is a promise, not money moved. When you actually pay, also record it under Giving so your spending stays correct.'}),
  onSave:async v=>{const a=parseFloat(String(v.amount).replace(/,/g,'')),pd=parseFloat(String(v.paid||'0').replace(/,/g,''))||0;
   if(!(a>0)||!(v.who||'').trim())return false;
   await col('pledges').doc(p.id||rid()).set({dir:v.dir||'give',who:v.who.trim(),amount:a,paid:Math.max(0,pd),due:v.due||'',note:v.note||'',created:p.created||todayS()})},
  onDelete:p.id?()=>col('pledges').doc(p.id).delete():null});}

const STATUS=['Scouting','Drafting','Submitted','Shortlisted','Awarded','Declined','Closed'];
const safeUrl=u=>{try{const x=new URL(String(u||'').trim());return x.protocol==='https:'||x.protocol==='http:'?x.href:''}catch(e){return''}};
function appSheet(a){
 const isNew=!a;a=a||{name:'',funder:'',status:'Scouting',deadline:'',dtime:'',link:'',link2:'',note:''};
 openSheet({title:isNew?'New application':'Edit application',data:a,
  fields:[{k:'name',label:'Application / opportunity',type:'text',ph:'e.g. USPF Changemaker Challenge'},
   {k:'funder',label:'Funder / organiser',type:'text'},
   {k:'status',label:'Status',type:'select',opts:STATUS.map(x=>[x,x])},
   {k:'deadline',label:'Deadline date',type:'date'},
   {k:'dtime',label:'Deadline time (and note the time zone in the remark)',type:'time'},
   {k:'link',label:'Application link',type:'text',ph:'https://…'},
   {k:'link2',label:'Other link (guidelines, portal, my draft)',type:'text',ph:'https://…'},
   {k:'note',label:'Remark',type:'area',ph:'Requirements, what is left, contacts, outcome…'}],
  extra:()=>el('div',{class:'note',text:'Never store passwords here. Keep only links and notes.'}),
  onSave:async v=>{if(!(v.name||'').trim())return false;
   const l1=(v.link||'').trim(),l2=(v.link2||'').trim();if((l1&&!safeUrl(l1))||(l2&&!safeUrl(l2)))throw new Error('A link must start with https://');
   await col('apps').doc(a.id||rid()).set({name:v.name.trim(),funder:v.funder||'',status:v.status||'Scouting',deadline:v.deadline||'',dtime:v.dtime||'',link:l1,link2:l2,note:v.note||'',created:a.created||todayS()})},
  onDelete:a.id?()=>col('apps').doc(a.id).delete():null});}
function journalSheet(j){
 const isNew=!j;j=j||{date:todayS(),mood:3,title:'',story:'',people:'',lesson:''};
 openSheet({title:isNew?'New journal entry':'Edit entry',data:j,
  fields:[{k:'date',label:'Date',type:'date'},
   {k:'title',label:'Headline (optional)',type:'text',ph:'e.g. Met a maize farmer in Billiri'},
   {k:'story',label:'What happened — my experience',type:'area',ph:'Write freely…'},
   {k:'people',label:'Who I met / encounters',type:'area',ph:'Names, roles, what we discussed, follow-up'},
   {k:'lesson',label:'What I learned / will do next',type:'area'},
   {k:'mood',label:'How the day felt (1 hard – 5 great)',type:'seg',opts:[1,2,3,4,5].map(n=>[n,String(n)])}],
  extra:()=>el('div',{class:'note',text:'Be careful with other people’s private details. Sync stores this in your own Supabase.'}),
  onSave:async v=>{if(!((v.story||'').trim()||(v.title||'').trim()||(v.people||'').trim()))return false;
   await col('journal').doc(j.id||rid()).set({date:v.date||todayS(),title:v.title||'',story:v.story||'',people:v.people||'',lesson:v.lesson||'',mood:+v.mood||3,created:j.created||todayS()})},
  onDelete:j.id?()=>col('journal').doc(j.id).delete():null});}
/* ---------- csv ---------- */
function csvCell(v){if(v==null)return'';if(typeof v==='number')return String(v);let t=String(v);if(/^[=+\-@\t\r]/.test(t))t="'"+t;return/[",\n\r]/.test(t)?'"'+t.replace(/"/g,'""')+'"':t}
